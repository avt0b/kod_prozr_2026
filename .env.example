# Переменные окружения «Код прозрачности». Скопировать: cp .env.example .env
# Источник правды по именам — docs/contracts.md. .env в git не коммитим.
#
# Этот файл читают:
#   - docker compose (подстановка ${VAR} в docker-compose.yml);
#   - контейнер backend (env_file);
#   - Makefile (LLM_MODEL для make llm-up).
# Значения без кавычек и без пробелов — так их одинаково понимают compose и make.

# --- Postgres (сервис postgres) ---------------------------------------------
POSTGRES_USER=kodprozr
POSTGRES_PASSWORD=kodprozr
POSTGRES_DB=kodprozr

# --- Backend ----------------------------------------------------------------
# Строка подключения SQLAlchemy (async). Хост `postgres` — имя сервиса в compose.
# Если бэк запускается на хосте (uv run ...), заменить postgres -> localhost.
DATABASE_URL=postgresql+asyncpg://kodprozr:kodprozr@postgres:5432/kodprozr

# Разрешённые origin'ы фронта через запятую: 5173 — vite dev, 3000 — nginx в compose.
# На VPS добавить https://<домен>.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ASGI-приложение для uvicorn (только для compose). Сверить с backend/README.md.
BACKEND_APP=src.web.main:app

# --- LLM (OpenAI-совместимый API) -------------------------------------------
# Варианты LLM_BASE_URL:
#   локальная Ollama из compose (make llm-up):  http://ollama:11434/v1
#   Ollama на хосте, бэк в Docker:              http://host.docker.internal:11434/v1
#     (extra_hosts в compose уже есть; Ollama должна слушать не только 127.0.0.1:
#     OLLAMA_HOST=0.0.0.0, и файрвол хоста не должен резать трафик из docker-сетей —
#     проверка: make llm-check; подробно docs/devops.md §5)
#   общая Ollama команды на другой машине:       http://<ip-машины>:11434/v1
#     или через SSH-туннель (безопаснее): http://localhost:11434/v1 для бэка на хосте
#   бэк на хосте + ollama из compose:           http://localhost:11434/v1
#   vLLM / облачный провайдер:                  https://<provider>/v1
# Без LLM (пусто) разбор обращений и докладные работают на правилах и шаблоне (ADR-05).
LLM_BASE_URL=http://ollama:11434/v1
# Для Ollama подойдёт любая непустая строка; для облака — реальный ключ (sk-...).
LLM_API_KEY=ollama
# Имя модели у провайдера. Для Ollama это тег, который скачает make llm-up.
LLM_MODEL=qwen2.5:7b-instruct
# 7B на CPU отвечает десятки секунд; фронт ждёт ответа до 150 с.
LLM_TIMEOUT_SECONDS=90
# Ожидание соединения с LLM. Недоступная LLM (в т.ч. DROP на файрволе) даёт фоллбэк
# через столько секунд, без повторной попытки.
LLM_CONNECT_TIMEOUT_SECONDS=5

# Порог «закупки чуть ниже порога» для R08, ₽ (тот же --threshold у генератора).
PROCUREMENT_THRESHOLD=600000

# --- Frontend ---------------------------------------------------------------
# Базовый URL API для браузера. Вшивается в бандл при сборке (build-arg),
# после изменения нужен make build. На VPS: https://<домен>/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# --- Docker / DevOps --------------------------------------------------------
# На какой адрес хоста публиковать порты. 127.0.0.1 — только локально
# (на VPS наружу ходит reverse proxy). 0.0.0.0 — показать демо по локальной сети.
BIND_HOST=127.0.0.1
# Хост-порты (по умолчанию из contracts.md). Если порт на машине занят другим проектом,
# поменяйте его здесь; для BACKEND_PORT поменяйте и VITE_API_URL выше (и make build).
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
OLLAMA_PORT=11434
# Ollama отдельно от BIND_HOST: 0.0.0.0 — раздать общую LLM команде (только доверенная сеть).
# OLLAMA_BIND_HOST=0.0.0.0
# Сеть для docker build: host (по умолчанию в Makefile) обходит bridge-сеть, из которой
# на машинах команды нет интернета (VPN/TUN); default — обычная сборка в bridge.
# BUILD_NETWORK=host
# GPU для make llm-up: auto (runtime nvidia в docker info) | 1 | 0.
# LLM_GPU=auto
# Версии образов закреплены (OPS-08): демо не должно меняться от выхода нового latest.
# Ollama 0.12.6 — версия, на которой AI-03 гоняет модель. Последняя стабильная на 15.11 —
# 0.40.16; переходить только после прогона make llm-up + make eval на ней.
OLLAMA_IMAGE=ollama/ollama:0.12.6
POSTGRES_IMAGE=postgres:16.15-alpine
