# Для запуска бэка на хосте: cp .env.example .env (читается из backend/.env).
# В Docker переменные приходят из корневого .env (см. ../.env.example и docs/contracts.md).

DATABASE_URL=postgresql+asyncpg://kodprozr:kodprozr@localhost:5432/kodprozr
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Пустой LLM_BASE_URL — LLM выключена: анализ обращений на правилах, докладная по шаблону.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b-instruct

# --- Необязательные (у всех есть значения по умолчанию) ---
# APP_ENV=dev
# LOG_LEVEL=INFO
# DB_ECHO=false
# LLM_TIMEOUT_SECONDS=60
# LLM_CONNECT_TIMEOUT_SECONDS=5
# PROCUREMENT_THRESHOLD=600000
SEED_DIR=../data/generated

# Generate independently for each environment; at least 32 random characters.
AUTH_SECRET=
AUTH_ACCESS_SECONDS=900
AUTH_REFRESH_DAYS=7
# false only for local HTTP. Production requires true and HTTPS.
AUTH_COOKIE_SECURE=false
